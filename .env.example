VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: notifications on devices (Web Push). The public half of the pair
# `yarn vapid-keys` prints; push-send gets both halves. Unset, the app never
# offers device notifications (the bell still works).
VITE_VAPID_PUBLIC_KEY=

# Optional: where the sibling apps live, for the app switcher. Unset, each is the
# folder beside this app (../elevance-work/, ../elevance-support/, ../elevance-people/).
VITE_SUITE_WORK_URL=
VITE_SUITE_SUPPORT_URL=
VITE_SUITE_PEOPLE_URL=
